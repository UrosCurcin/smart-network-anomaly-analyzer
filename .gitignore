# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# IDE
.idea/
.vscode/

# Runtime data generated by the app (not source, don't version)
data/*.db
data/*.db-shm
data/*.db-wal
artifacts/evidence/*.pcap
logs/*.pcap

# Trained model artifacts (regenerate via baseline training / --save-model)
*.joblib

# OS cruft
.DS_Store
Thumbs.db

# Frontend build output/deps (frontend/ has its own .gitignore too,
# but this covers node_modules/dist wherever they might appear)
node_modules/

# The full logs/ folder holds real, potentially sensitive packet captures
# from the developer's own machine -- keep those local, but do version the
# one synthetic file the README/tests reference so the project is
# reproducible for anyone who clones it.
!logs/mixed_traffic_test.pcap
